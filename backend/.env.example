# ============================================================================
# CareMend Backend Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values
# .env is listed in .gitignore and should NEVER be committed

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================
# PostgreSQL connection string for production
# Format: postgresql://username:password@host:port/database_name
# For Render PostgreSQL: Use the DATABASE_URL provided by Render
DATABASE_URL=postgresql://user:password@localhost:5432/caremend_dev

# ============================================================================
# AUTHENTICATION & SECURITY (REQUIRED)
# ============================================================================
# JWT Secret Key for token signing - use a strong random string
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum recommended length: 32 characters
JWT_SECRET_KEY=your-super-secret-key-here-minimum-32-characters-required

# ============================================================================
# AI & EXTERNAL API KEYS (OPTIONAL)
# ============================================================================
# Groq API Key for CareConnect healthcare guidance
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Gemini API Key (Legacy - currently not used)
# Get key at: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# SERVER CONFIGURATION (USUALLY AUTO-SET BY RENDER)
# ============================================================================
# Server port - Render sets this automatically, default: 5000
PORT=5000

# Server host binding - keep as 0.0.0.0 for Render
HOST=0.0.0.0

# Flask debug mode - NEVER set to True in production
FLASK_DEBUG=False

# ============================================================================
# ML MODEL CONFIGURATION (OPTIONAL)
# ============================================================================
# Path to osteoporosis ML model directory
# Default: backend/models/osteoporosis
# Override only if deploying models to custom location
CAREMEND_MODEL_DIR=backend/models/osteoporosis

# ============================================================================
# LOGGING CONFIGURATION (OPTIONAL)
# ============================================================================
# Log file location
# Default: backend/caremend.log
LOG_FILE=backend/caremend.log

# ============================================================================
# FIREBASE CONFIGURATION (DEPRECATED - Not currently used)
# ============================================================================
# Firebase project config (legacy, kept for reference)
# FIREBASE_API_KEY=your_firebase_api_key
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ============================================================================
# DEPLOYMENT-SPECIFIC NOTES
# ============================================================================
# For Render deployment:
# 1. Render automatically provides DATABASE_URL for PostgreSQL instances
# 2. Keep JWT_SECRET_KEY secure - use strong random value
# 3. GROQ_API_KEY is optional but recommended for AI features
# 4. All other variables have sensible defaults

# For local development:
# 1. Copy this file: cp .env.example .env
# 2. Update DATABASE_URL for local PostgreSQL
# 3. Leave other values as is for development
# 4. Never commit .env file
